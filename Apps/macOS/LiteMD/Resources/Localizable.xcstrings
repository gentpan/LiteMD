    "LiteMD cannot replace itself in “%@”. Move LiteMD to the Applications folder and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteMD cannot replace itself in “%@”. Move LiteMD to the Applications folder and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteMD 无法在“%@”中替换自身。请把 LiteMD 移到“应用程序”文件夹后重试。"
          }
        }
      }
    },
    "LiteMD closed unexpectedly.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteMD closed unexpectedly."
          }
