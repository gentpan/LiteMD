          }
        }
      }
    },
    "LiteMD is not allowed to use speech recognition. You can allow it in System Settings → Privacy & Security → Speech Recognition.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteMD is not allowed to use speech recognition. You can allow it in System Settings → Privacy & Security → Speech Recognition."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteMD 没有语音识别权限。可以在“系统设置 → 隐私与安全性 → 语音识别”中允许。"
          }
        }
      }
    },
    "LiteMD is up to date.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteMD is up to date."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteMD 已是最新版本。"
          }
        }
      }
    },
    "LiteMD keeps a copy of a file before overwriting it, at most once every 10 minutes. Versions appear here after you edit and save this document. iCloud conflict versions from your other devices also appear here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteMD keeps a copy of a file before overwriting it, at most once every 10 minutes. Versions appear here after you edit and save this document. iCloud conflict versions from your other devices also appear here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteMD 在覆盖文件前会保存一份副本，同一文件最多每 10 分钟一份。编辑并保存此文稿后，历史版本会出现在这里。其他设备通过 iCloud 产生的冲突版本也会显示在这里。"
          }
        }
      }
    },
    "LiteMD stores recent items, session state, crash recovery snapshots, version history and backup records here. Your Markdown files are never stored in this folder.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteMD stores recent items, session state, crash recovery snapshots, version history and backup records here. Your Markdown files are never stored in this folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteMD 在这里保存最近使用、会话状态、崩溃恢复快照、历史版本和备份记录。你的 Markdown 文件不会存放在这个文件夹中。"
          }
        }
      }
    },
