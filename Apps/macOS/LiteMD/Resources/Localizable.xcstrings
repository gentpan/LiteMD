    "Backups are one-way: LiteMD uploads new and changed files from the open folder and never changes files on this Mac. Files you delete stay in the bucket unless you turn on the option above.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups are one-way: LiteMD uploads new and changed files from the open folder and never changes files on this Mac. Files you delete stay in the bucket unless you turn on the option above."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份是单向的：LiteMD 只上传当前文件夹中新增和修改的文件，不会改动这台 Mac 上的任何文件。除非开启上面的选项，本地删除的文件仍会保留在存储桶中。"
          }
        }
      }
    },
